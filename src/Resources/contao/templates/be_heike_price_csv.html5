.heike-import h2{font-size:17px;margin:0 0 18px;line-height:1.4}
.heike-import p{margin:0 0 16px}
.heike-import .hi-section{padding:24px;margin:0 0 24px;border:1px solid #ddd;border-radius:4px;background:#fff}
.heike-import .hi-step{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;margin-right:10px;border-radius:50%;background:#f0f0f0;color:#555;font-size:13px}
.heike-import .hi-field{margin-bottom:22px;max-width:620px}
.heike-import .hi-label{display:block;margin-bottom:7px;font-weight:600}
.heike-import input[type=file]{display:block;width:100%;padding:12px;border:1px dashed #b8bec4;background:#fafafa;border-radius:3px;line-height:1.6}
.heike-import input[type=file]::file-selector-button{padding:7px 12px;margin-right:12px;border:1px solid #bbb;border-radius:3px;background:#fff;color:#333;cursor:pointer}
.heike-import .tl_select{display:block;width:100%;max-width:620px;height:auto;min-height:36px;padding:7px 30px 7px 10px}
.heike-import .hi-help{font-size:12px;color:#666;margin:7px 0 0;line-height:1.6}
.heike-import .hi-choices{border:0;margin:0 0 22px;padding:0;max-width:720px;min-width:0}
.heike-import .hi-choices legend{margin-bottom:9px;font-weight:600}
.heike-import .hi-choice{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;border:1px solid #ddd;border-radius:3px;margin-bottom:10px;cursor:pointer}
.heike-import .hi-choice:has(input:checked){border-color:#ef8000;background:#fff8ee}
.heike-import .hi-choice input{flex:0 0 auto;margin:5px 0 0}
.heike-import .hi-choice strong{display:block;font-weight:600}
.heike-import .hi-choice small{display:block;color:#666;font-size:12px;line-height:1.6;margin-top:3px}
