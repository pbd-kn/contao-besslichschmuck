<?php $this->extend('be_main'); ?>

<?php $this->block('main'); ?>
<style>
.hp-backend { margin: 18px; max-width: 900px; color: #222; font: 13px/1.45 Arial, sans-serif; }
.hp-backend h2 { margin: 0 0 16px; font-size: 22px; font-weight: 600; }
.hp-panel { margin: 0 0 18px; border: 1px solid #cdd3d8; border-radius: 3px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.hp-panel__head { padding: 12px 16px; border-bottom: 1px solid #e5e9ec; background: #f6f7f8; font-weight: 600; }
.hp-panel__body { padding: 16px; }
.hp-field { margin: 0 0 16px; }
.hp-field label, .hp-field-title { display: block; margin: 0 0 6px; font-weight: 600; color: #444; }
.hp-field select { box-sizing: border-box; width: 100%; max-width: 360px; padding: 7px 8px; border: 1px solid #aaa; border-radius: 2px; font: 13px Arial, sans-serif; }
.hp-check { display: flex; gap: 8px; align-items: center; margin: 0 0 16px; }
.hp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
@media (max-width: 900px) { .hp-backend { margin: 12px; } }
</style>

<div class="hp-backend">
  <h2><?= htmlspecialchars($this->headline) ?></h2>
  <?= Contao\Message::generate() ?>

  <section class="hp-panel">
    <div class="hp-panel__head">CSV-Datei importieren</div>
    <div class="hp-panel__body">
      <form id="csvImportForm" action="" method="post">
        <input type="hidden" name="FORM_SUBMIT" value="csv_form">
        <input type="hidden" name="FORM_MODE" value="preview">
        <input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">

        <div class="hp-field">
          <span class="hp-field-title">CSV-Datei</span>
          <?= $this->csvCheckbox ?>
        </div>

        <div class="hp-field">
          <label for="ausgabe">Ausgabe</label>
          <select name="ausgabe" id="ausgabe">
            <option value="0" selected>Standard</option>
            <option value="1">Standard/Fehler</option>
            <option value="2">Standard/Fehler/Warnungen</option>
            <option value="3">Standard/Fehler/Warnungen/Debug</option>
          </select>
        </div>

        <div class="hp-check">
          <input type="checkbox" name="delEntries" id="delEntries" checked>
          <label for="delEntries">Tabelle vor dem Import loeschen</label>
        </div>

        <div class="hp-actions">
          <button type="submit" class="tl_submit"><?= htmlspecialchars($this->submit) ?></button>
          <a class="tl_submit" href="<?= $this->redirekturl ?>">Zur&uuml;ck zur Tabelle</a>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var form = document.getElementById('csvImportForm');
  if (!form) {
    return;
  }

  form.addEventListener('submit', function(event) {
    if (!form.querySelector('input[type="radio"]:checked')) {
      event.preventDefault();
      alert('Bitte waehlen Sie eine CSV-Datei aus.');
    }
  });
});
</script>
<?php $this->endblock(); ?>
