<?php $this->extend('be_main'); ?>

<?php $this->block('main'); ?>
<style>
.hp-backend { margin: 18px; max-width: 1180px; color: #222; font: 13px/1.45 Arial, sans-serif; }
.hp-backend h2 { margin: 0 0 16px; font-size: 22px; font-weight: 600; }
.hp-panel { margin: 0 0 18px; border: 1px solid #cdd3d8; border-radius: 3px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.hp-panel__head { padding: 12px 16px; border-bottom: 1px solid #e5e9ec; background: #f6f7f8; font-weight: 600; }
.hp-panel__body { padding: 16px; }
.hp-grid { display: grid; grid-template-columns: repeat(2, minmax(260px, 1fr)); gap: 4px 18px; }
.hp-span-2 { grid-column: 1 / -1; }
.hp-field { min-width: 0; margin: 0 0 14px; }
.hp-field label { display: block; margin: 0 0 5px; font-weight: 600; color: #444; }
.hp-field input, .hp-field select, .hp-field textarea { box-sizing: border-box; width: 100%; padding: 7px 8px; border: 1px solid #aaa; border-radius: 2px; font: 13px/1.35 Arial, sans-serif; }
.hp-field textarea { min-height: 112px; resize: vertical; }
.hp-help { margin: 5px 0 0; color: #666; }
.hp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.hp-table-wrap { overflow-x: auto; }
.hp-table { width: 100%; min-width: 920px; border-collapse: collapse; }
.hp-table th, .hp-table td { padding: 8px 10px; border-bottom: 1px solid #e5e9ec; text-align: left; vertical-align: top; }
.hp-table th { background: #f6f7f8; font-weight: 600; white-space: nowrap; }
.hp-table td:nth-child(3) { max-width: 420px; overflow-wrap: anywhere; font-family: Consolas, monospace; }
.hp-table td:last-child { white-space: nowrap; text-align: right; }
.hp-inline-form { margin: 0; }
.hp-note { margin: 0 0 14px; padding: 10px 12px; border: 1px solid #cdd3d8; background: #f8fafc; color: #444; }
.hp-code { font-family: Consolas, monospace; overflow-wrap: anywhere; }
.hp-vars { display: flex; flex-wrap: wrap; gap: 6px; }
.hp-var { padding: 3px 6px; border: 1px solid #d8dee4; border-radius: 2px; background: #f6f8fa; font-family: Consolas, monospace; }
@media (max-width: 900px) { .hp-backend { margin: 12px; } .hp-grid { grid-template-columns: 1fr; } .hp-span-2 { grid-column: auto; } }
</style>

<?php $editRule = $this->editRule ?: array(); ?>

<div class="hp-backend">
  <h2><?= htmlspecialchars($this->headline) ?></h2>
  <?= Contao\Message::generate() ?>

  <p class="hp-note">
    Formelregeln berechnen Zielfelder aus Artikelfeldern, Zwischenergebnissen und globalen Variablen.
    Erlaubt sind Zahlen, Variablen, Klammern und <span class="hp-code">+ - * /</span>.
  </p>

  <section class="hp-panel">
    <div class="hp-panel__head"><?= $editRule ? 'Formelregel bearbeiten' : 'Formelregel speichern' ?></div>
    <div class="hp-panel__body">
      <form method="post">
        <input type="hidden" name="FORM_SUBMIT" value="tl_preisliste_formula_rules">
        <input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">
        <input type="hidden" name="action" value="save">

        <div class="hp-grid">
          <div class="hp-field">
            <label for="ctrl_artikel_code">Gilt f&uuml;r Artikel</label>
            <input type="text" name="artikel_code" id="ctrl_artikel_code" value="<?= htmlspecialchars((string) ($editRule['artikel_code'] ?? '')) ?>" placeholder="leer = alle Artikel">
            <p class="hp-help">Leer lassen f&uuml;r Standardregeln. Einen Artikelwert eintragen, wenn die Regel nur f&uuml;r diesen Artikel gelten soll.</p>
          </div>
          <div class="hp-field">
            <label for="ctrl_target_field">Berechnetes Feld</label>
            <select name="target_field" id="ctrl_target_field" required>
              <?php foreach ($this->targetFields as $field): ?>
                <option value="<?= htmlspecialchars($field) ?>"<?= (($editRule['target_field'] ?? '') === $field) ? ' selected' : '' ?>><?= htmlspecialchars(($this->targetLabels[$field] ?? $field).' ('.$field.')') ?></option>
              <?php endforeach; ?>
            </select>
          </div>
          <div class="hp-field hp-span-2">
            <label for="ctrl_label">Beschreibung</label>
            <input type="text" name="label" id="ctrl_label" value="<?= htmlspecialchars((string) ($editRule['label'] ?? '')) ?>">
          </div>
          <div class="hp-field hp-span-2">
            <label for="ctrl_formula">Formel</label>
            <textarea name="formula" id="ctrl_formula" required><?= htmlspecialchars((string) ($editRule['formula'] ?? '')) ?></textarea>
          </div>
        </div>

        <div class="hp-actions">
          <button class="tl_submit" type="submit">Speichern</button>
          <?php if ($editRule): ?>
            <a class="tl_submit" href="<?= $this->rulesUrl ?? '' ?>">Neue Regel</a>
          <?php endif; ?>
          <a class="tl_submit" href="<?= $this->backUrl ?>">Zur&uuml;ck</a>
        </div>
      </form>
    </div>
  </section>

  <section class="hp-panel">
    <div class="hp-panel__head">Gespeicherte Formelregeln</div>
    <div class="hp-table-wrap">
      <table class="hp-table">
        <thead>
          <tr>
            <th>Gilt f&uuml;r</th>
            <th>Berechnetes Feld</th>
            <th>Formel</th>
            <th>Beschreibung</th>
            <th>Aktiv</th>
            <th>Aktion</th>
          </tr>
        </thead>
        <tbody>
          <?php foreach ($this->rows as $row): ?>
            <tr>
              <td><?= htmlspecialchars($row['artikel_code'] ?: 'Alle Artikel') ?></td>
              <td><?= htmlspecialchars($this->targetLabels[$row['target_field']] ?? $row['target_field']) ?><br><span class="hp-code"><?= htmlspecialchars($row['target_field']) ?></span></td>
              <td><span class="hp-code"><?= htmlspecialchars($row['formula']) ?></span><?php if (!empty($this->formulaHints[$row['target_field']])): ?><br><span class="hp-help"><?= htmlspecialchars($this->formulaHints[$row['target_field']]) ?></span><?php endif; ?></td>
              <td><?= htmlspecialchars($row['label']) ?></td>
              <td><?= $row['active'] ? 'ja' : 'nein' ?></td>
              <td>
                <a class="tl_submit" href="?artikel_code=<?= urlencode($row['artikel_code']) ?>&amp;target_field=<?= urlencode($row['target_field']) ?>">Bearbeiten</a>
                <form class="hp-inline-form" method="post" onsubmit="return confirm('Formelregel wirklich l&ouml;schen?');">
                  <input type="hidden" name="FORM_SUBMIT" value="tl_preisliste_formula_rules_delete">
                  <input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="artikel_code" value="<?= htmlspecialchars($row['artikel_code']) ?>">
                  <input type="hidden" name="target_field" value="<?= htmlspecialchars($row['target_field']) ?>">
                  <button class="tl_submit" type="submit">L&ouml;schen</button>
                </form>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </section>

  <section class="hp-panel">
    <div class="hp-panel__head">Globale Variablen, die in Formeln verwendet werden koennen</div>
    <div class="hp-table-wrap">
      <table class="hp-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Beschreibung</th>
            <th>Wert</th>
            <th>Einheit</th>
            <th>Aktion</th>
          </tr>
        </thead>
        <tbody>
          <?php foreach ($this->globalRows as $row): ?>
            <tr>
              <td class="hp-code"><?= htmlspecialchars($row['param_key']) ?></td>
              <td><?= htmlspecialchars($row['label']) ?></td>
              <td><?= htmlspecialchars($row['param_value']) ?></td>
              <td><?= htmlspecialchars($row['unit']) ?></td>
              <td><a class="tl_submit" href="<?= $this->globalsUrl ?>?edit=<?= urlencode($row['param_key']) ?>">Bearbeiten</a></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </section>

  <section class="hp-panel">
    <div class="hp-panel__head">Verwendbare Variablen</div>
    <div class="hp-panel__body">
      <div class="hp-vars">
        <?php foreach ($this->availableVariables as $variable): ?>
          <span class="hp-var"><?= htmlspecialchars($variable) ?></span>
        <?php endforeach; ?>
      </div>
    </div>
  </section>
</div>
<?php $this->endblock(); ?>
