<?php $escape=static fn($v)=>\Contao\StringUtil::specialchars((string)$v); ?>
<div class="tl_formbody_edit" style="padding:28px;line-height:1.6">
<p>Aktive Preisquelle: <strong><?= $this->status['active']?'Tabellenverwaltung – '.$escape($this->status['active']['title']):'Ursprüngliche Preisliste (tl_heike_preisliste)' ?></strong></p>
<?php if($this->error): ?><p class="tl_error"><?= $escape($this->error) ?></p><?php endif; ?>
<?php if($this->message): ?><p class="tl_confirm"><?= $escape($this->message) ?></p><?php endif; ?>
<?php if(!$this->status['ready']): ?><p>Bitte zuerst im Contao-Datenbankupdate die neuen Felder für die Preisquelle anlegen. Die bisherige Preisliste bleibt bis zur Aktivierung in Verwendung.</p><?php else: ?>
<h2 style="margin-top:24px">Übernahme prüfen und aktivieren</h2>
<p>Zuerst die vorhandene Preisliste unter „Besslich-Preisliste übernehmen“ kopieren. Der Vergleich prüft sämtliche Datensätze und Quellfelder. Bei Doppelungen wird der bisherige Einzelpreistreffer dieser Installation gespeichert. Die Aktivierung veröffentlicht die kopierten Einträge.</p>
<form method="post"><input type="hidden" name="FORM_SUBMIT" value="heike_price_source"><input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->token) ?>"><button class="tl_submit" name="action" value="preview">Alte und neue Preisliste vergleichen</button></form>
<?php if($this->preview): ?><p style="margin-top:20px"><strong><?= (int)$this->preview['count'] ?> Datensätze vollständig identisch.</strong></p>
<?php if($this->preview['duplicates']): ?><details><summary><?= count($this->preview['duplicates']) ?> Zuordnungen für doppelte Artikel übernehmen</summary><ul><?php foreach($this->preview['duplicates'] as $row): ?><li><?= $escape($row['article']) ?> → Quell-ID <?= (int)$row['sourceId'] ?></li><?php endforeach; ?></ul></details><?php endif; ?>
<form method="post" style="margin-top:16px"><input type="hidden" name="FORM_SUBMIT" value="heike_price_source"><input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->token) ?>"><input type="hidden" name="nonce" value="<?= $escape($this->nonce) ?>"><p><label><input type="checkbox" name="confirmed" value="1" required> Ich habe eine Datenbanksicherung erstellt und den Vergleich geprüft.</label></p><button class="tl_submit" name="action" value="activate">Tabellenverwaltung als Preisquelle aktivieren</button></form>
<?php endif; ?>
<?php if($this->status['active']&&$this->status['legacy']): ?>
<h2 style="margin-top:32px">Zur ursprünglichen Preisliste zurückkehren</h2><p>Neuere Preisänderungen aus der Tabellenverwaltung werden dadurch nicht in die alte Tabelle übertragen. Deren bisheriger Stand wird wieder verwendet.</p>
<form method="post"><input type="hidden" name="FORM_SUBMIT" value="heike_price_source"><input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->token) ?>"><p><label><input type="checkbox" name="confirmed" value="1" required> Ich möchte wieder die ursprünglichen Preise verwenden.</label></p><button class="tl_submit" name="action" value="legacy">Ursprüngliche Preisquelle verwenden</button></form>
<?php endif; endif; ?>
<p style="margin-top:24px"><a href="contao?do=directories">Zur Tabellenverwaltung</a></p>
</div>
