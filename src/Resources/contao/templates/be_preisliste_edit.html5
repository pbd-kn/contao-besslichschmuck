<?php $this->extend('be_main'); ?>

<?php $this->block('main'); ?>
<style>
.hp-backend { margin: 18px; max-width: 1180px; color: #222; font: 13px/1.45 Arial, sans-serif; }
.hp-backend h2 { margin: 0 0 16px; font-size: 22px; font-weight: 600; }
.hp-panel { margin: 0 0 18px; border: 1px solid #cdd3d8; border-radius: 3px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.hp-panel__head { padding: 12px 16px; border-bottom: 1px solid #e5e9ec; background: #f6f7f8; font-weight: 600; }
.hp-panel__body { padding: 16px; }
.hp-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; }
.hp-field { min-width: 0; margin: 0 0 14px; }
.hp-field label { display: block; margin: 0 0 5px; font-weight: 600; color: #444; }
.hp-field input, .hp-field textarea { box-sizing: border-box; width: 100%; max-width: 100%; padding: 7px 8px; border: 1px solid #aaa; border-radius: 2px; background: #fff; font: 13px/1.35 Arial, sans-serif; }
.hp-field textarea { min-height: 112px; resize: vertical; }
.hp-search { flex: 1 1 320px; max-width: 520px; }
.hp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 2px; }
.hp-grid { display: grid; grid-template-columns: repeat(2, minmax(260px, 1fr)); gap: 4px 18px; }
.hp-grid--prices { grid-template-columns: repeat(4, minmax(150px, 1fr)); }
.hp-grid--wide { grid-template-columns: repeat(3, minmax(180px, 1fr)); }
.hp-span-2 { grid-column: 1 / -1; }
.hp-table-wrap { overflow-x: auto; }
.hp-table { width: 100%; border-collapse: collapse; }
.hp-table th, .hp-table td { padding: 8px 10px; border-bottom: 1px solid #e5e9ec; text-align: left; vertical-align: top; }
.hp-table th { background: #f6f7f8; font-weight: 600; white-space: nowrap; }
.hp-table td:last-child { white-space: nowrap; text-align: right; }
.hp-message { margin: 0 0 14px; padding: 10px 12px; border-radius: 3px; }
.hp-message--ok { border: 1px solid #9ccf99; background: #edf8ec; color: #236423; }
.hp-message--error { border: 1px solid #d9a1a1; background: #fff0f0; color: #8a1f1f; }
.hp-empty { margin: 0; color: #666; }
@media (max-width: 900px) { .hp-grid, .hp-grid--prices { grid-template-columns: 1fr; } .hp-backend { margin: 12px; } }
</style>

<?php
$fieldLabels = $this->fieldLabels ?: array();
$fieldGroups = $this->fieldGroups ?: array('Felder' => $this->fields);
?>

<div class="hp-backend">
  <h2><?= htmlspecialchars($this->headline) ?></h2>

  <?php if ($this->message): ?>
    <p class="hp-message <?= $this->isError ? 'hp-message--error' : 'hp-message--ok' ?>"><?= htmlspecialchars($this->message) ?></p>
  <?php endif; ?>

  <section class="hp-panel">
    <div class="hp-panel__head">Artikel suchen</div>
    <div class="hp-panel__body">
      <form method="get" action="<?= $this->editUrl ?>" class="hp-toolbar">
        <input type="hidden" name="view" value="edit">
        <div class="hp-field hp-search">
          <label for="ctrl_q">Suchbegriff</label>
          <input type="text" name="q" id="ctrl_q" value="<?= htmlspecialchars($this->q) ?>">
        </div>
        <div class="hp-actions">
          <button class="tl_submit" type="submit">Suchen</button>
          <a class="tl_submit" href="<?= $this->backUrl ?>">Zur&uuml;ck</a>
        </div>
      </form>
    </div>
  </section>

  <?php if ($this->rows): ?>
    <section class="hp-panel">
      <div class="hp-panel__head">Suchergebnisse</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Artikel</th>
              <th>Kategorie</th>
              <th>Subkategorie</th>
              <th>Beschreibung</th>
              <th>Aktion</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->rows as $item): ?>
              <tr>
                <td><?= (int) $item['id'] ?></td>
                <td><?= htmlspecialchars((string) $item['Artikel']) ?></td>
                <td><?= htmlspecialchars((string) $item['Kategorie']) ?></td>
                <td><?= htmlspecialchars((string) $item['Subkategorie']) ?></td>
                <td><?= htmlspecialchars((string) $item['Beschreibung']) ?></td>
                <td><a class="tl_submit" href="<?= $this->editUrl ?>&amp;id=<?= (int) $item['id'] ?>">Bearbeiten</a></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>
  <?php elseif (!$this->row && $this->q !== ''): ?>
    <section class="hp-panel"><div class="hp-panel__body"><p class="hp-empty">Keine passenden Artikel gefunden.</p></div></section>
  <?php endif; ?>

  <?php if ($this->row): ?>
    <form method="post">
      <input type="hidden" name="FORM_SUBMIT" value="tl_preisliste_edit">
      <input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">
      <input type="hidden" name="action" value="save">
      <input type="hidden" name="id" value="<?= (int) $this->row['id'] ?>">

      <?php foreach ($fieldGroups as $groupLabel => $groupFields): ?>
        <section class="hp-panel">
          <div class="hp-panel__head"><?= htmlspecialchars($groupLabel) ?></div>
          <div class="hp-panel__body hp-grid <?= $groupLabel === 'Preise und Zwischenergebnisse' ? 'hp-grid--wide' : '' ?>">
            <?php foreach ($groupFields as $field): ?>
              <div class="hp-field <?= $field === 'Beschreibung' ? 'hp-span-2' : '' ?>">
                <label for="ctrl_<?= htmlspecialchars($field) ?>"><?= htmlspecialchars($fieldLabels[$field] ?? $field) ?></label>
                <?php if ($field === 'Beschreibung'): ?>
                  <textarea name="<?= htmlspecialchars($field) ?>" id="ctrl_<?= htmlspecialchars($field) ?>"><?= htmlspecialchars((string) ($this->row[$field] ?? '')) ?></textarea>
                <?php else: ?>
                  <input type="text" name="<?= htmlspecialchars($field) ?>" id="ctrl_<?= htmlspecialchars($field) ?>" value="<?= htmlspecialchars((string) ($this->row[$field] ?? '')) ?>">
                <?php endif; ?>
              </div>
            <?php endforeach; ?>
          </div>
        </section>
      <?php endforeach; ?>

      <div class="tl_submit_container hp-actions">
        <button class="tl_submit" type="submit">Speichern</button>
        <a class="tl_submit" href="<?= $this->backUrl ?>">Zur&uuml;ck</a>
      </div>
    </form>
  <?php endif; ?>
</div>
<?php $this->endblock(); ?>
