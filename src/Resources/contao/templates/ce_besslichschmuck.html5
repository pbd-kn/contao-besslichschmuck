      echo "</div>\n";
    }
    echo $this->divpreisliste;
  echo "</div>\n";

  // EFG was removed. Popup articles are selected explicitly via Zusatzinfo.
  // Empty/default selections must not produce a non-functional button.
  $pop = trim((string) $this->zusatzinfo);
  if ($pop !== '' && $pop !== '0') {
    echo "<div class='popupurl'>\n";
    $opnstr = 'AjaxGetArticle(' . json_encode($pop, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)
      . ',' . json_encode((string) $GLOBALS['objPage']->id) . ');';
    echo '<button type="button" onclick="' . htmlspecialchars($opnstr, ENT_QUOTES, 'UTF-8') . '">auswahl ketten</button>' . "\n";
/*  Beispiel popup mit neuem Window
    $opnstr='window.open("' . $this->myurl . '", "Popup", "scrollbars=1;width=800,height=1024,left=500,location=0,menubar=0,status=0,titlebar=0,toolbar=0");';
