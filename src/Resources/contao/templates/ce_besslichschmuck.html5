*/
    echo "</div>\n";
  }
  //echo "<div class='detail-linkback'>\n";
  //echo "<span class='detail-linkback-icon'";
  //echo "<i class='fa fa-chevron-left'>&nbsp;</i>";
  //echo "</span>";
  echo "<div class='detail-linkback'>\n";
  $o="";
  $o.= \Contao\System::getContainer()->get('contao.insert_tag.parser')->replaceInline("{{link_open::back}}")."<span class='fa fa-chevron-left'>&nbsp;</span>";
  $o.= "<span class=detail-linkback-txt>".\Contao\System::getContainer()->get('contao.insert_tag.parser')->replaceInline("{{link_title::back|utf8_strtolower}}")."</span>";
  $o.= \Contao\System::getContainer()->get('contao.insert_tag.parser')->replaceInline("{{link_close}}");
  echo $o;
  echo "</div>\n";
echo "</div>\n";

