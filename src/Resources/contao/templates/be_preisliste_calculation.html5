<?php $this->extend('be_main'); ?>

<?php $this->block('main'); ?>
<style>
.hp-backend { margin: 18px; max-width: 1280px; color: #222; font: 13px/1.45 Arial, sans-serif; }
.hp-backend h2 { margin: 0 0 16px; font-size: 22px; font-weight: 600; }
.hp-panel { margin: 0 0 18px; border: 1px solid #cdd3d8; border-radius: 3px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.hp-panel__head { padding: 12px 16px; border-bottom: 1px solid #e5e9ec; background: #f6f7f8; font-weight: 600; }
.hp-panel__body { padding: 16px; }
.hp-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; }
.hp-field { flex: 1 1 320px; max-width: 520px; margin: 0; }
.hp-field label { display: block; margin: 0 0 5px; font-weight: 600; color: #444; }
.hp-field input { box-sizing: border-box; width: 100%; padding: 7px 8px; border: 1px solid #aaa; border-radius: 2px; font: 13px Arial, sans-serif; }
.hp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.hp-table-wrap { overflow-x: auto; }
.hp-table { width: 100%; border-collapse: collapse; }
.hp-table th, .hp-table td { padding: 8px 10px; border-bottom: 1px solid #e5e9ec; text-align: left; vertical-align: top; }
.hp-table th { background: #f6f7f8; font-weight: 600; white-space: nowrap; }
.hp-code { font-family: Consolas, monospace; overflow-wrap: anywhere; }
.hp-summary { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 12px; }
.hp-summary div { padding: 10px; border: 1px solid #e5e9ec; background: #fafafa; }
.hp-summary strong { display: block; margin-bottom: 4px; color: #555; }
.hp-note { margin: 0 0 18px; padding: 10px 12px; border: 1px solid #d6c58a; background: #fff8dc; color: #624b00; }
.hp-badge { display: inline-block; padding: 2px 6px; border-radius: 2px; background: #edf3fa; color: #1d4f7a; font-size: 12px; }
@media (max-width: 900px) { .hp-backend { margin: 12px; } .hp-summary { grid-template-columns: 1fr; } }
</style>

<?php
$money = function ($value) {
    return number_format((float) $value, 2, ',', '.');
};
?>

<div class="hp-backend">
  <h2><?= htmlspecialchars($this->headline) ?></h2>

  <section class="hp-panel">
    <div class="hp-panel__body">
      <form method="get" class="hp-toolbar">
        <div class="hp-field">
          <label for="ctrl_q">Artikel suchen</label>
          <input type="text" name="q" id="ctrl_q" value="<?= htmlspecialchars($this->q) ?>">
        </div>
        <div class="hp-actions">
          <button class="tl_submit" type="submit">Suchen</button>
          <a class="tl_submit" href="<?= $this->backUrl ?>">Zur&uuml;ck</a>
          <a class="tl_submit" href="<?= $this->globalsUrl ?>">Globale Variablen</a>
          <a class="tl_submit" href="<?= $this->rulesUrl ?>">Formelregeln</a>
        </div>
      </form>
    </div>
  </section>

  <?php if ($this->message): ?>
    <p class="hp-note"><?= htmlspecialchars($this->message) ?></p>
  <?php endif; ?>

  <?php if ($this->rows): ?>
    <section class="hp-panel">
      <div class="hp-panel__head">Suchergebnisse</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Artikel</th>
              <th>Kategorie</th>
              <th>Subkategorie</th>
              <th>Aktion</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->rows as $item): ?>
              <tr>
                <td><?= (int) $item['id'] ?></td>
                <td><?= htmlspecialchars((string) $item['Artikel']) ?></td>
                <td><?= htmlspecialchars((string) $item['Kategorie']) ?></td>
                <td><?= htmlspecialchars((string) $item['Subkategorie']) ?></td>
                <td><a class="tl_submit" href="?id=<?= (int) $item['id'] ?>">Berechnung anzeigen</a></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>
  <?php endif; ?>

  <?php if ($this->row && $this->explain): ?>
    <?php if ($this->explain['missingSourceFields']): ?>
      <p class="hp-note">
        Hinweis: Einige technische Berechnungsspalten fehlen im aktuellen Datensatz oder in der Tabelle:
        <span class="hp-code"><?= htmlspecialchars(implode(', ', $this->explain['missingSourceFields'])) ?></span>.
        Diese Werte werden in der Erklaerung mit 0 angesetzt, bis die CSV-/Tabellenspalten vorhanden sind.
      </p>
    <?php endif; ?>

    <section class="hp-panel">
      <div class="hp-panel__head">
        <?= htmlspecialchars((string) $this->explain['articleCode']) ?>
        <?php if ($this->explain['articleTitle'] !== $this->explain['articleCode']): ?>
          - <?= htmlspecialchars((string) $this->explain['articleTitle']) ?>
        <?php endif; ?>
      </div>
      <div class="hp-panel__body hp-summary">
        <?php foreach ($this->explain['summary'] as $field => $value): ?>
          <div>
            <strong><?= htmlspecialchars($field) ?></strong>
            <?= $money($value) ?>
          </div>
        <?php endforeach; ?>
      </div>
    </section>

    <section class="hp-panel">
      <div class="hp-panel__head">Preisberechnung Schritt fuer Schritt</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>Feld</th>
              <th>Formel / Regel</th>
              <th>Wert</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->explain['priceSteps'] as $step): ?>
              <tr>
                <td class="hp-code"><?= htmlspecialchars($step[0]) ?></td>
                <td class="hp-code"><?= htmlspecialchars((string) $step[1]) ?></td>
                <td><?= $money($step[2]) ?></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>

    <section class="hp-panel">
      <div class="hp-panel__head">EK-Bausteine und globale Variablen</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>Baustein</th>
              <th>Rechnung</th>
              <th>Wert</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->explain['partSteps'] as $step): ?>
              <tr>
                <td class="hp-code"><?= htmlspecialchars($step[0]) ?></td>
                <td class="hp-code"><?= htmlspecialchars((string) $step[1]) ?></td>
                <td><?= $money($step[2]) ?></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>

    <section class="hp-panel">
      <div class="hp-panel__head">Verwendete Variablen in aktiven Formelregeln</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>Zielfeld</th>
              <th>Variable</th>
              <th>Wert</th>
              <th>Quelle</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->explain['variables'] as $variable): ?>
              <tr>
                <td class="hp-code"><?= htmlspecialchars($variable['target']) ?></td>
                <td class="hp-code"><?= htmlspecialchars($variable['name']) ?></td>
                <td><?= $money($variable['value']) ?> <?= htmlspecialchars($variable['unit']) ?></td>
                <td>
                  <?php if ($variable['isGlobal']): ?>
                    <span class="hp-badge">global</span>
                    <?= htmlspecialchars($variable['label']) ?>
                  <?php else: ?>
                    berechnet / Artikelfeld
                  <?php endif; ?>
                </td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>

    <section class="hp-panel">
      <div class="hp-panel__head">Aktive Formelregeln</div>
      <div class="hp-table-wrap">
        <table class="hp-table">
          <thead>
            <tr>
              <th>Zielfeld</th>
              <th>Formel</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($this->explain['rules'] as $field => $formula): ?>
              <tr>
                <td class="hp-code"><?= htmlspecialchars($field) ?></td>
                <td class="hp-code"><?= htmlspecialchars($formula) ?></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </section>
  <?php endif; ?>
</div>
<?php $this->endblock(); ?>
