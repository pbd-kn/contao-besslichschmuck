              <td><?= htmlspecialchars($row['updated_at']) ?></td>
              <td>
                <a class="tl_submit" href="?edit=<?= urlencode($row['param_key']) ?>">Bearbeiten</a>
                <form class="hp-inline-form" method="post" onsubmit="return confirm('Variable wirklich l&ouml;schen?');">
                  <input type="hidden" name="FORM_SUBMIT" value="tl_preisliste_globals_delete">
                  <input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="param_key" value="<?= htmlspecialchars($row['param_key']) ?>">
                  <button class="tl_submit" type="submit">L&ouml;schen</button>
                </form>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </section>

