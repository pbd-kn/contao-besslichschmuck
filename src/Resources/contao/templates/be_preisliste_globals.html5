        <div class="hp-grid">
          <div class="hp-field">
            <label for="ctrl_param_key">Formelname</label>
            <input type="text" name="param_key" id="ctrl_param_key" value="<?= htmlspecialchars((string) ($editRow['param_key'] ?? '')) ?>" required>
          </div>
          <div class="hp-field">
            <label for="ctrl_label">Beschreibung</label>
            <input type="text" name="label" id="ctrl_label" value="<?= htmlspecialchars((string) ($editRow['label'] ?? '')) ?>">
          </div>
          <div class="hp-field">
            <label for="ctrl_param_value">Wert</label>
            <input type="text" name="param_value" id="ctrl_param_value" value="<?= htmlspecialchars((string) ($editRow['param_value'] ?? '')) ?>" required>
          </div>
          <div class="hp-field">
            <label for="ctrl_unit">Einheit</label>
            <input type="text" name="unit" id="ctrl_unit" value="<?= htmlspecialchars((string) ($editRow['unit'] ?? '')) ?>">
          </div>
        </div>

        <div class="hp-actions">
          <button class="tl_submit" type="submit">Speichern</button>
